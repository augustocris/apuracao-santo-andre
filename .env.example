# Supabase project (Settings → API)
# Obrigatório em produção (Vercel → Environment Variables → Production → Redeploy).
# Sem estas duas variáveis o app entra em modo MOCK e NÃO grava no banco.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: service role for server-side import routes only (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Mock local demo:
# - Sem URL/key: usa store em memória.
# - Em production (Vercel) o seed demo NÃO é carregado (lista vazia + banner MOCK).
# - Em `next dev`, o seed demo é carregado por padrão.
# - Force seed: NEXT_PUBLIC_ALLOW_MOCK_SEED=true
# - Disable seed even in dev: NEXT_PUBLIC_ALLOW_MOCK_SEED=false
# NEXT_PUBLIC_ALLOW_MOCK_SEED=true
